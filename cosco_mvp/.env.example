# Copia este archivo como .env y pega la cadena de conexión de Supabase
# (botón Connect → "Transaction pooler", puerto 6543). El "Session pooler" (5432) se llena con 15 clientes
# y el equipo ya lo agotó una vez.
# Si se deja vacío, todo funciona con SQLite local en data/cosco.db
DATABASE_URL=postgresql://postgres.<ref-del-proyecto>:<TU-CONTRASEÑA>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Llave gratis de Google AI Studio (https://aistudio.google.com/apikey) para vectorizar la memoria del asistente
GEMINI_API_KEY=
